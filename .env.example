# Base paths/server
RAG_BASE_DIR=.
RAG_HOST=0.0.0.0
RAG_PORT=10663
RAG_DEBUG=0

# Auth/secrets - replace before running in production
RAG_AUTH_CODE=change-me
RAG_JWT_SECRET=change-me-in-production
RAG_EXPORT_API_KEY=
RAG_TOKEN=
RAG_API_BASE=http://localhost:10663

# Cloud LLM (OpenAI-compatible / DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Local Ollama / embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=mistral-nemo
EMBEDDING_MODEL=bge-m3
RAG_KB_NAME=papers

# Optional autonomous-agent backend
# Core search/RAG endpoints do not need these. Web Agent Mode, Deep Read,
# DocMod, and paper-writing workflows need an external coding/research agent.
# Current server implementation is Claude Code-compatible. Codex/OpenCode can
# be used externally with agent_tools or via a wrapper that emits Claude-style
# stream-json events.
RAG_AGENT_BACKEND=claude
CLAUDE_BIN=claude
CODEX_BIN=codex
OPENCODE_BIN=opencode
RAG_AGENT_ADAPTER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional script overrides
RAG_SEGMENTS_PATH=
RAG_DOC_DETAILS_CACHE=
RAG_KEYWORD_PROGRESS=
